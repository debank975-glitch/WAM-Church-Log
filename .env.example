NODE_ENV=development
PORT=3000
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/hermes.sqlite
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
PGSSLMODE=require
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_CODE=replace-with-a-one-time-bootstrap-code
SESSION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# SMTP delivery for invitation codes to the administrator
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Fallback recipient when the administrator account has no email
ADMIN_EMAIL=
