NODE_ENV=development
PORT=3000
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/hermes.sqlite
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
PGSSLMODE=require
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_CODE=replace-with-a-one-time-bootstrap-code
SESSION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Gmail API OAuth delivery for invitation codes
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_OAUTH_SETUP_KEY=
ADMIN_EMAIL=
